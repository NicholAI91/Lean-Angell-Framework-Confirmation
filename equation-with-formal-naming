import Mathlib.Analysis.SpecialFunctions.Pow.Real

open Real

/-!
# Logistic Growth with Power-Law Drag

This module analyzes the fixed points of a generalized non-dimensionalized 
logistic differential equation with power-law dissipation:
  f(α, p, x) = x * (1 - x) - α * x^p
-/

namespace LogisticDrag

/-- The steady-state balance function for logistic growth with power-law drag. -/
noncomputable def balanceFunction (α p x : ℝ) : ℝ := 
  x * (1 - x) - α * x ^ p

/-- The trivial equilibrium at x = 0 exists for all drag exponents p > 1. -/
theorem zero_equilibrium (α p : ℝ) (hp : 1 < p) : 
    balanceFunction α p 0 = 0 := by
  have h : (0 : ℝ) ^ p = 0 := Real.zero_rpow (by linarith)
  unfold balanceFunction
  rw [h]
  ring

/-- At normalized carrying capacity x = 1, the growth rate reduces strictly to -α. -/
theorem carrying_capacity_value (α p : ℝ) : 
    balanceFunction α p 1 = -α := by
  unfold balanceFunction
  rw [Real.one_rpow]
  ring

/-- The non-trivial equilibrium curve relating drag coefficient α to steady state x > 0. -/
theorem equilibrium_manifold (α p x : ℝ) (hx : 0 < x) (h : balanceFunction α p x = 0) :
    α = (1 - x) / x ^ (p - 1) := by
  unfold balanceFunction at h
  have hpos : x ^ (p - 1) ≠ 0 := (Real.rpow_pos_of_pos hx _).ne'
  have hsplit : x ^ p = x * x ^ (p - 1) := by
    calc x ^ p = x ^ ((1 : ℝ) + (p - 1)) := by congr 1; ring
      _ = x ^ (1 : ℝ) * x ^ (p - 1) := Real.rpow_add hx _ _
      _ = x * x ^ (p - 1) := by rw [Real.rpow_one]
  rw [hsplit] at h
  have hfac : x * (1 - x - α * x ^ (p - 1)) = 0 := by
    calc x * (1 - x - α * x ^ (p - 1)) = x * (1 - x) - α * (x * x ^ (p - 1)) := by ring
      _ = 0 := h
  cases mul_eq_zero.mp hfac with
  | inl hx0 => linarith
  | inr hsub =>
    have hα : α * x ^ (p - 1) = 1 - x := by linarith
    exact eq_div_of_mul_eq hpos hα

/-- For quadratic drag (p = 2), the equilibrium curve evaluated at the golden reciprocal 
    x = 1/φ yields exactly α = 1/φ. -/
theorem quadratic_equilibrium_at_golden_ratio (φ : ℝ) (hφ : φ ^ 2 = φ + 1) (hpos : 1 < φ) :
    (1 - 1 / φ) / (1 / φ) ^ ((2 : ℝ) - 1) = 1 / φ := by
  have hφ0 : φ ≠ 0 := by linarith
  have h1 : ((2 : ℝ) - 1) = (1 : ℝ) := by norm_num
  rw [h1, Real.rpow_one]
  have hstep1 : (1 - 1 / φ) / (1 / φ) = φ - 1 := by
    field_simp
    
  have hstep2 : φ - 1 = 1 / φ := by
    apply (eq_div_iff hφ0).mpr
    calc (φ - 1) * φ = φ ^ 2 - φ := by ring
      _ = (φ + 1) - φ := by rw [hφ]
      _ = 1 := by ring
  calc (1 - 1 / φ) / (1 / φ) = φ - 1 := hstep1
    _ = 1 / φ := hstep2

end LogisticDrag
